string name = "Samet";
string absent = null;
string message = "Hello " + name;
Console.WriteLine(message);
Console.WriteLine(null + "left");
Console.WriteLine("right" + absent);
Console.WriteLine(name.Length);
Console.WriteLine(name.ToUpper());
Console.WriteLine(name.ToLower());
Console.WriteLine(name.Contains("Sam"));
Console.WriteLine(name.StartsWith("Sa"));
Console.WriteLine(name.EndsWith("et"));
Console.WriteLine(name.IndexOf("me"));
Console.WriteLine(name.LastIndexOf("a"));
Console.WriteLine("banana".Replace("an", "X"));
Console.WriteLine("abcdef".Substring(2));
Console.WriteLine("abcdef".Substring(1, 3));
Console.WriteLine("  hi \t".Trim());
Console.WriteLine("  hi".TrimStart());
Console.WriteLine("hi  ".TrimEnd());
Console.WriteLine("café");
Console.WriteLine("".Contains(""));
Console.WriteLine(String.IsNullOrEmpty(null));
Console.WriteLine(String.IsNullOrEmpty(""));
Console.WriteLine(String.IsNullOrWhiteSpace(" \t"));
Console.WriteLine(String.IsNullOrWhiteSpace(" x"));
Console.WriteLine(String.Format("Hi {0}, {1}, {2}, {{ok}}", "Samet", 123, true));
Console.WriteLine(String.Format("negative={0}", -123));
Console.WriteLine(String.Format("plain text"));
Console.WriteLine(String.Format("{1}/{0}/{1}", "a", "b"));
Console.WriteLine(String.Format("null={0}", null));
string original = "abc";
string replaced = original.Replace("b", "x");
Console.WriteLine(original + ":" + replaced);
