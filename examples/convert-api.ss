string integerText = "  -123  ";
string floatingText = "12.5";
int byteValue = Convert.ToByte("255");
int signedByteValue = Convert.ToSByte("-128");
int shortValue = Convert.ToInt16("32767");
int unsignedShortValue = Convert.ToUInt16("65535");
int integerValue = Convert.ToInt32(integerText);
int unsignedIntegerValue = Convert.ToUInt32("4294967295");
int longValue = Convert.ToInt64("-9223372036854775808");
ulong unsignedLongValue = Convert.ToUInt64("18446744073709551615");
float singleValue = Convert.ToSingle(floatingText);
double doubleValue = Convert.ToDouble(floatingText);
double decimalValue = Convert.ToDecimal("42.125");
bool booleanValue = Convert.ToBoolean(" true ");
char characterValue = Convert.ToChar("é");

Console.WriteLine(byteValue);
Console.WriteLine(signedByteValue);
Console.WriteLine(shortValue);
Console.WriteLine(unsignedShortValue);
Console.WriteLine(integerValue);
Console.WriteLine(unsignedIntegerValue);
Console.WriteLine(longValue);
Console.WriteLine(unsignedLongValue);
Console.WriteLine(singleValue);
Console.WriteLine(doubleValue);
Console.WriteLine(decimalValue);
Console.WriteLine(booleanValue);
Console.WriteLine(Convert.ToString(characterValue));
Console.WriteLine(characterValue);
Console.WriteLine(Convert.ToString(123));
Console.WriteLine(Convert.ToBoolean(1));
Console.WriteLine(Convert.ToInt32(null));
Console.WriteLine(Convert.ToString(null));
Console.WriteLine(Convert.ToInt32(Convert.ToDouble("2.5")));
Console.WriteLine(Convert.ToInt32(Convert.ToDouble("3.5")));
Console.WriteLine(Convert.ToInt32(Convert.ToDouble("-2.5")));
Console.WriteLine(Convert.ToDouble("1e20"));
Console.WriteLine(Convert.ToDouble("1e-10"));
Console.WriteLine(Convert.ToBoolean(null));
Console.WriteLine(Convert.ToString(false));
Console.WriteLine(Convert.ToString(-123));
Console.WriteLine(Convert.ToDouble("NaN"));
Console.WriteLine(Convert.ToDouble("-Infinity"));
